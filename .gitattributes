# Texto com LF em todas as máquinas (o CI roda no Windows e no Linux).
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Dados fictícios e anexos com hash registrado: bytes exatos, sem conversão de
# fim de linha. Um CRLF no checkout do Windows mudaria o SHA-256 (check_dados D3)
# e os testes de ida e volta.
docs/especificacao/anexos/*.json -text
tests/fixtures/** -text
estudos/**/*.json -text
