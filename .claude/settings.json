{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/verificar.py:*)",
      "Bash(python scripts/ci/:*)",
      "Bash(python -m unittest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m compileall:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(~/AppData/Local/pesquisa-streaming/**)",
      "Edit(~/AppData/Local/pesquisa-streaming/**)",
      "Read(**/pesquisa-streaming/**)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite-wal)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(sqlite3:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/guarda.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/guarda.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop.py\""
          }
        ]
      }
    ]
  }
}
